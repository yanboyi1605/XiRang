.top-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 24rpx;
}

.brand-left {
  display: flex;
  align-items: center;
}

.seal {
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  color: #f9f3e7;
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  line-height: 68rpx;
  text-align: center;
  background: linear-gradient(145deg, #b14c36, #953826);
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 3rpx rgba(255, 247, 232, 0.24);
  transform: rotate(-2deg);
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: Georgia, "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
  line-height: 1.2;
}

.brand-sub {
  margin-top: 2rpx;
  color: #788279;
  font-size: 12rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-tagline {
  max-width: 300rpx;
  color: #788279;
  font-family: Georgia, "Songti SC", serif;
  font-size: 18rpx;
  font-style: italic;
  line-height: 1.5;
  text-align: right;
}

.setup-card {
  padding-bottom: 24rpx;
}

.setup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(23, 37, 31, 0.07);
}

.setup-title {
  display: flex;
  align-items: center;
}

.step-no {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  color: #b58f52;
  font-family: Georgia, serif;
  font-size: 18rpx;
  font-style: italic;
  line-height: 38rpx;
  text-align: center;
  border: 1rpx solid rgba(181, 143, 82, 0.45);
  border-radius: 50%;
}

.setup-name {
  font-family: Georgia, "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.auto-pill {
  color: #788279;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.stock-picker {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-top: 22rpx;
  background: linear-gradient(140deg, rgba(238, 230, 215, 0.95), rgba(247, 241, 231, 0.9));
  border: 1rpx solid rgba(23, 37, 31, 0.07);
  border-radius: 20rpx;
}

.stock-picker:active {
  opacity: 0.8;
}

.stock-icon {
  width: 62rpx;
  height: 62rpx;
  margin-right: 16rpx;
  color: #f8f1e4;
  font-family: Georgia, "Songti SC", serif;
  font-size: 30rpx;
  line-height: 62rpx;
  text-align: center;
  background: #123b2c;
  border-radius: 16rpx;
}

.stock-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.stock-name {
  overflow: hidden;
  font-family: Georgia, "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stock-code {
  margin-top: 3rpx;
  color: #788279;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.search-pill {
  padding: 8rpx 18rpx;
  color: #123b2c;
  font-size: 20rpx;
  background: rgba(255, 253, 247, 0.65);
  border: 1rpx solid rgba(23, 37, 31, 0.14);
  border-radius: 999rpx;
}

.source-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #788279;
  font-size: 18rpx;
}

.stock-range {
  margin-top: 4rpx;
  color: #a0a89f;
  font-size: 17rpx;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
  color: #3b4a42;
  font-size: 22rpx;
  font-weight: 600;
}

.input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  padding: 0 20rpx;
  color: #17251f;
  font-size: 26rpx;
  background: rgba(255, 253, 247, 0.78);
  border: 1rpx solid rgba(23, 37, 31, 0.12);
  border-radius: 16rpx;
}

.picker-value {
  width: 100%;
}

.picker-arrow {
  color: #b58f52;
  font-size: 20rpx;
}

.date-notice {
  margin-top: 8rpx;
  color: #a05f2d;
  font-size: 18rpx;
}

.date-error {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 8rpx;
  color: #a05f2d;
  font-size: 18rpx;
  line-height: 1.6;
}

.text-link {
  margin-left: 10rpx;
  color: #1d5a43;
  text-decoration: underline;
}

.seg {
  display: flex;
  padding: 5rpx;
  background: rgba(236, 228, 211, 0.78);
  border-radius: 16rpx;
}

.seg-btn {
  flex: 1;
  height: 58rpx;
  color: #788279;
  font-size: 21rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 12rpx;
}

.seg-btn.on {
  color: #123b2c;
  font-weight: 600;
  background: #fffdf8;
  box-shadow: 0 3rpx 8rpx rgba(18, 59, 44, 0.1);
}

.amount-row {
  display: flex;
  margin-top: 22rpx;
}

.amount-item {
  flex: 1;
  min-width: 0;
}

.amount-item + .amount-item {
  margin-left: 14rpx;
}

.amount-label {
  display: block;
  margin-bottom: 8rpx;
  color: #3b4a42;
  font-size: 21rpx;
  font-weight: 600;
}

.money-box {
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 14rpx;
  background: rgba(255, 253, 247, 0.78);
  border: 1rpx solid rgba(23, 37, 31, 0.12);
  border-radius: 14rpx;
}

.money-symbol {
  flex: 0 0 auto;
  margin-right: 6rpx;
  color: #788279;
  font-size: 20rpx;
}

.money-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  color: #17251f;
  font-size: 27rpx;
  font-family: "DIN Alternate", sans-serif;
}

.hint {
  display: block;
  margin-top: 8rpx;
  color: #788279;
  font-size: 18rpx;
  line-height: 1.55;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx;
  margin-top: 22rpx;
  background: rgba(238, 230, 215, 0.58);
  border-radius: 16rpx;
}

.switch-copy {
  display: flex;
  flex-direction: column;
}

.switch-title {
  color: #17251f;
  font-size: 22rpx;
  font-weight: 600;
}

.switch-sub {
  margin-top: 2rpx;
  color: #788279;
  font-size: 17rpx;
}

.adv-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 2rpx 10rpx;
  margin-top: 10rpx;
  color: #3b4a42;
  font-size: 21rpx;
  font-weight: 600;
  border-top: 1rpx dashed rgba(23, 37, 31, 0.1);
}

.adv-arrow {
  color: #788279;
  font-size: 18rpx;
  font-weight: 400;
}

.advanced-box {
  padding: 4rpx 0 2rpx;
}

.adv-block {
  padding-top: 14rpx;
  margin-top: 12rpx;
  border-top: 1rpx dashed rgba(23, 37, 31, 0.07);
}

.adv-label {
  display: block;
  margin-bottom: 10rpx;
  color: #3b4a42;
  font-size: 20rpx;
  font-weight: 600;
}

.mini-seg {
  display: flex;
  padding: 4rpx;
  background: rgba(236, 228, 211, 0.7);
  border-radius: 12rpx;
}

.mini-seg-btn {
  flex: 1;
  height: 50rpx;
  color: #788279;
  font-size: 19rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 9rpx;
}

.mini-seg-btn.on {
  color: #123b2c;
  font-weight: 600;
  background: #fffdf8;
}

.check-row {
  display: flex;
  align-items: center;
}

.check-copy {
  display: flex;
  flex-direction: column;
  margin-left: 10rpx;
}

.tax-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.tax-label {
  color: #788279;
  font-size: 20rpx;
}

.tax-input {
  width: 90rpx;
  height: 54rpx;
  padding: 0 10rpx;
  margin-left: 12rpx;
  color: #17251f;
  font-size: 24rpx;
  text-align: center;
  background: rgba(255, 253, 247, 0.8);
  border: 1rpx solid rgba(23, 37, 31, 0.12);
  border-radius: 9rpx;
}

.tax-unit {
  margin-left: 8rpx;
  color: #788279;
  font-size: 20rpx;
}

.calc-btn {
  margin-top: 24rpx;
}

.panel-note {
  display: block;
  margin-top: 10rpx;
  color: #788279;
  font-size: 17rpx;
  text-align: center;
}

.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  margin-bottom: 20rpx;
  color: #96341f;
  font-size: 20rpx;
  line-height: 1.5;
  background: rgba(178, 69, 48, 0.08);
  border: 1rpx solid rgba(178, 69, 48, 0.18);
  border-radius: 16rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
  color: #3b4a42;
  font-size: 24rpx;
}

.empty-card .muted {
  margin-top: 8rpx;
  font-size: 19rpx;
}

/* ---------- hero ---------- */

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 32rpx 30rpx 0;
  margin-bottom: 22rpx;
  color: #f4efe4;
  background: linear-gradient(115deg, #0d3124 0%, #123c2d 48%, #1a4d39 100%);
  border-radius: 28rpx;
  box-shadow: 0 30rpx 60rpx -40rpx rgba(13, 49, 36, 0.8);
}

.hero-card::after {
  content: "";
  position: absolute;
  top: -180rpx;
  right: -120rpx;
  width: 440rpx;
  height: 440rpx;
  border: 1rpx solid rgba(236, 212, 166, 0.14);
  border-radius: 50%;
}

.hero-label {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  color: rgba(244, 239, 228, 0.68);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.gold-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 10rpx;
  background: #ecd4a6;
  border-radius: 50%;
}

.hero-asof {
  margin-left: 10rpx;
  color: rgba(244, 239, 228, 0.45);
  font-size: 17rpx;
}

.hero-value {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  margin: 14rpx 0 12rpx;
}

.hero-currency {
  margin: 10rpx 8rpx 0 0;
  color: #ecd4a6;
  font-family: Georgia, serif;
  font-size: 30rpx;
}

.hero-number {
  color: #faf5e9;
  font-family: Georgia, "Songti SC", serif;
  font-size: 76rpx;
  line-height: 1.05;
  letter-spacing: -1rpx;
}

.hero-sub {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.gain-pill {
  padding: 5rpx 14rpx;
  color: #f0d5a5;
  font-size: 20rpx;
  font-weight: 600;
  background: rgba(236, 212, 166, 0.11);
  border: 1rpx solid rgba(236, 212, 166, 0.28);
  border-radius: 999rpx;
}

.gain-pill.down {
  color: #b3d5c1;
  background: rgba(179, 213, 193, 0.09);
  border-color: rgba(179, 213, 193, 0.22);
}

.hero-profit {
  margin-left: 12rpx;
  color: rgba(244, 239, 228, 0.68);
  font-size: 19rpx;
}

.hero-stats {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 0 4rpx;
  margin-top: 18rpx;
  border-top: 1rpx solid rgba(244, 239, 228, 0.11);
}

.hero-stat {
  display: flex;
  width: 50%;
  flex-direction: column;
  padding-bottom: 18rpx;
}

.stat-label {
  color: rgba(244, 239, 228, 0.52);
  font-size: 18rpx;
}

.stat-value {
  margin-top: 4rpx;
  color: #f7f1e5;
  font-family: "DIN Alternate", sans-serif;
  font-size: 30rpx;
}

.hero-foot {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  padding: 14rpx 0 16rpx;
  margin: 0 -30rpx;
  color: rgba(244, 239, 228, 0.56);
  font-size: 17rpx;
  line-height: 1.7;
  background: rgba(0, 0, 0, 0.12);
  border-top: 1rpx solid rgba(244, 239, 228, 0.08);
}

.hero-foot text {
  padding: 0 30rpx;
}

/* ---------- charts ---------- */

.chart-canvas {
  display: block;
  width: 100%;
  height: 380rpx;
  margin-top: 14rpx;
}

.chart-canvas-sm {
  height: 300rpx;
}

.chart-note {
  display: block;
  padding-top: 14rpx;
  margin-top: 6rpx;
  color: #788279;
  font-size: 18rpx;
  line-height: 1.55;
  border-top: 1rpx dashed rgba(23, 37, 31, 0.09);
}

.legend {
  display: flex;
  align-items: center;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-left: 14rpx;
  color: #788279;
  font-size: 17rpx;
}

.legend-line {
  width: 24rpx;
  height: 3rpx;
  margin-right: 6rpx;
  background: #1f5e46;
}

.legend-line.invest {
  height: 2rpx;
  background: repeating-linear-gradient(90deg, #b58f52 0, #b58f52 5rpx, transparent 5rpx, transparent 9rpx);
}

/* ---------- insights ---------- */

.insights {
  display: flex;
  margin-bottom: 22rpx;
}

.insight-card {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  padding: 20rpx 16rpx;
  margin-right: 12rpx;
  background: rgba(251, 248, 240, 0.9);
  border: 1rpx solid rgba(23, 37, 31, 0.07);
  border-radius: 18rpx;
}

.insight-card:last-child {
  margin-right: 0;
}

.insight-label {
  color: #788279;
  font-size: 16rpx;
  line-height: 1.4;
}

.insight-value {
  margin-top: 10rpx;
  color: #123b2c;
  font-family: "DIN Alternate", sans-serif;
  font-size: 30rpx;
  font-weight: 600;
}

.insight-text {
  margin-top: 6rpx;
  color: #788279;
  font-size: 16rpx;
  line-height: 1.5;
}

/* ---------- yearly ---------- */

.table-hint {
  display: block;
  margin: 8rpx 0 14rpx;
  color: #788279;
  font-size: 18rpx;
}

.year-item {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(23, 37, 31, 0.07);
}

.year-item.latest {
  margin: 0 -12rpx;
  padding: 18rpx 12rpx;
  background: rgba(18, 59, 44, 0.035);
  border-radius: 14rpx;
}

.year-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.year-name {
  display: flex;
  align-items: center;
}

.year-number {
  color: #17251f;
  font-family: "DIN Alternate", sans-serif;
  font-size: 24rpx;
  font-weight: 600;
}

.year-tag {
  margin-left: 8rpx;
  color: #b58f52;
  font-size: 16rpx;
}

.count-tag {
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  color: #788279;
  font-size: 15rpx;
  background: rgba(23, 37, 31, 0.05);
  border-radius: 6rpx;
}

.year-action {
  color: #b58f52;
  font-size: 18rpx;
}

.year-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.year-metric {
  display: flex;
  width: 50%;
  flex-direction: column;
  padding-bottom: 10rpx;
}

.m-label {
  color: #788279;
  font-size: 16rpx;
}

.m-value {
  margin-top: 3rpx;
  color: #3b4a42;
  font-family: "DIN Alternate", sans-serif;
  font-size: 24rpx;
}

.year-foot {
  margin-top: 12rpx;
  color: #788279;
  font-size: 17rpx;
}

.year-detail {
  padding: 16rpx;
  margin-top: 14rpx;
  background: rgba(239, 232, 218, 0.58);
  border-radius: 14rpx;
}

.detail-head {
  display: flex;
  flex-direction: column;
  padding-bottom: 10rpx;
  color: #3b4a42;
  font-size: 17rpx;
  line-height: 1.6;
  border-bottom: 1rpx dashed rgba(23, 37, 31, 0.1);
}

.detail-head text:last-child {
  color: #788279;
  font-size: 15rpx;
}

.dividend-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(23, 37, 31, 0.05);
}

.dividend-item:last-child {
  border-bottom: 0;
}

.dividend-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dividend-date {
  color: #17251f;
  font-family: "DIN Alternate", sans-serif;
  font-size: 20rpx;
}

.dividend-net {
  color: #123b2c;
  font-size: 20rpx;
  font-weight: 600;
}

.dividend-detail {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.dividend-detail text {
  margin-right: 14rpx;
  color: #788279;
  font-size: 16rpx;
  line-height: 1.7;
}

.share-events {
  padding-top: 12rpx;
  margin-top: 8rpx;
  border-top: 1rpx dashed rgba(23, 37, 31, 0.1);
}

.share-title {
  display: block;
  margin-bottom: 4rpx;
  color: #b58f52;
  font-size: 17rpx;
  font-weight: 600;
}

.share-row {
  display: flex;
  color: #788279;
  font-size: 16rpx;
  line-height: 1.7;
}

.share-row text:first-child {
  flex: 0 0 auto;
  margin-right: 12rpx;
}

.detail-empty {
  display: block;
  padding: 12rpx 0;
}

.table-foot {
  display: block;
  margin-top: 14rpx;
  color: #788279;
  font-size: 16rpx;
  line-height: 1.6;
}

/* ---------- notes ---------- */

.notes-card {
  padding: 26rpx;
  background: rgba(236, 228, 211, 0.5);
  border: 1rpx solid rgba(23, 37, 31, 0.06);
  border-radius: 20rpx;
}

.notes-title {
  display: block;
  margin-bottom: 10rpx;
  color: #3b4a42;
  font-family: Georgia, "Songti SC", serif;
  font-size: 26rpx;
  font-weight: 600;
}

.note-line {
  display: block;
  color: #788279;
  font-size: 17rpx;
  line-height: 1.8;
}
