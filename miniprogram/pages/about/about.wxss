.about-page {
  padding-top: 30rpx;
}

.about-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 8rpx 30rpx;
}

.about-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: #f8f2e6;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 52rpx;
  background: #a84732;
  border-radius: 8rpx;
  box-shadow: 0 12rpx 26rpx -16rpx rgba(168, 71, 50, 0.8);
}

.about-brand {
  display: flex;
  flex-direction: column;
}

.about-title {
  color: #17251f;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.about-sub {
  margin-top: 6rpx;
  color: #9b885f;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.about-kicker {
  display: block;
  margin-bottom: 8rpx;
  color: #b58f52;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.about-heading {
  display: block;
  margin-bottom: 18rpx;
  color: #17251f;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 600;
}

.about-p {
  display: block;
  color: #4f5b53;
  font-size: 27rpx;
  line-height: 1.75;
}

.about-p + .about-p {
  margin-top: 14rpx;
}

.about-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.about-dot {
  flex: none;
  color: #b58f52;
  font-size: 27rpx;
  line-height: 1.75;
}

.about-note {
  display: block;
  margin-top: 16rpx;
  padding-top: 16rpx;
  color: #8a938c;
  font-size: 23rpx;
  line-height: 1.7;
  border-top: 1rpx dashed rgba(23, 37, 31, 0.14);
}

.disclaimer-card {
  border-color: rgba(168, 71, 50, 0.22);
  background: linear-gradient(180deg, rgba(251, 248, 240, 0.98), rgba(247, 238, 226, 0.98));
}

.about-warn {
  display: block;
  margin-top: 20rpx;
  color: #a84732;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.about-foot {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 10rpx 12rpx 20rpx;
  color: #8a938c;
  font-size: 22rpx;
  line-height: 1.7;
}

.about-copy {
  margin-top: 10rpx;
  color: #b58f52;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
